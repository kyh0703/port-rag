# Required. Async SQLAlchemy URL for the port-dedicated Postgres (+pgvector).
# In docker-compose the host is `postgres`; locally use `localhost`.
DATABASE_URL=postgresql+asyncpg://port:port@postgres:5432/port

# Required. Use the same private key as API and Worker (32-256 printable ASCII characters).
# Compose injects this from the Infra .env; never expose it to the browser.
INTERNAL_SERVER_KEY=

# Trusted API service; embedding credentials come from the administrator settings.
API_INTERNAL_BASE_URL=http://api:8000/api/v1

HTTP_PORT=8000

# Exposes Prometheus application metrics at /metrics.
METRICS_ENABLED=true

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
TOP_K_DEFAULT=5

# Required. Shared only with the API service; use at least 32 random bytes.
RAG_RETRIEVAL_CAPABILITY_SECRET=<32-or-more-random-bytes>

# Optional. Enables Sentry reporting for unhandled FastAPI exceptions.
SENTRY_DSN=
